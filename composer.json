{
    "name": "yireo/magento2-csp-utilities",
    "version": "1.0.2",
    "description": "CSP utilities for various Magento modules",
    "type": "magento2-module",
    "require": {
        "ext-pcre": "*",
        "magento/framework": "^102.0 || ^103.0",
        "magento/module-backend": "^100.0 || ^101.0 || ^102.0",
        "magento/module-config": "^101.0",
        "magento/module-store": "^100.0 || ^101.0",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "license": "OSL-3.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Yireo\\CspUtilities\\": ""
        }
    }
}